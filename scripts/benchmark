#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 1 && ( $1 == --help || $1 == -h ) ]]; then
  echo "Usage: $0 [ROWS] [--joins] (default: 4000; joins: 200 rows per input)"
  exit 0
fi

benchmark=transform_and_render
default_rows=4000
if [[ ${!#} == --joins ]]; then
  benchmark=joins
  default_rows=200
  set -- "${@:1:$#-1}"
fi
rows=${1:-$default_rows}
if [[ $# -gt 1 || ! $rows =~ ^[1-9][0-9]*$ ]]; then
  echo "Usage: $0 [ROWS] [--joins] — ROWS must be a positive integer" >&2
  exit 1
fi

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
export BENCH_ROWS=$rows
exec bundle exec ruby -Ilib "benchmark/$benchmark.rb" --text
